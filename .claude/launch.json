{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "dryrun",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "start"
      ],
      "port": 8787
    },
    {
      "name": "dryrun-replay",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "start:replay"
      ],
      "port": 8788
    },
    {
      "name": "dryrun-ui",
      "runtimeExecutable": "bash",
      "runtimeArgs": [
        "-c",
        "SAMPLE_MODE=true PORT=8789 npx tsx src/api.ts"
      ],
      "port": 8789
    }
  ]
}