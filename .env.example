# Placeholder values only. Never commit real keys. Copy to .env and fill what you have.
# Provider order: every call tries these in turn (Nightshift first, per sponsor rules).
PROVIDERS=nightshift,nvidia,ollama

# Nightshift (Meterless) local OpenAI-compatible proxy. Token is read from <stateDir>/proxy-token if unset.
NIGHTSHIFT_BASE_URL=http://127.0.0.1:8088/v1
NIGHTSHIFT_TOKEN=
NIGHTSHIFT_STATE_DIR=

# Direct NVIDIA fallback (build.nvidia.com key, starts with nvapi-)
NVIDIA_API_KEY=
NVIDIA_RPM=38

# Local Nemotron through Ollama (ollama pull nemotron-3-nano:4b)
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_CONCURRENCY=3

# Zetaris. Leave blank to use the local DuckDB federation fallback (labelled in the UI).
# Host of the Zetaris API. The local bundle serves it on port 8888 (not 8889).
ZETARIS_BASE_URL=http://localhost:8888
ZETARIS_USER=
ZETARIS_PASSWORD=
ZETARIS_API_KEY=
ZETARIS_ORG_ID=1
# Where Zetaris can read this project's files. scripts/zetaris-mount.sh mounts the project at /home/zetaris/customer-data/shared/dryrun.
# Without it, tables stay on local DuckDB.
ZETARIS_FILE_ROOT=/home/zetaris/customer-data/shared/dryrun

# Replay recorded model and SQL responses instead of calling providers.
SAMPLE_MODE=false
RECORD=true
PORT=8787

# Meta Ads launch action (docs/META_SETUP.md). Use a sandbox ad account; Dry Run creates everything paused.
META_ACCESS_TOKEN=
META_AD_ACCOUNT_ID=
META_PAGE_ID=
META_INSTAGRAM_USER_ID=
META_LINK_URL=https://example.com
META_DAILY_BUDGET_CENTS=500

# Server bind address (Docker image sets 0.0.0.0) and /run timeout
HOST=127.0.0.1
RUN_TIMEOUT_MS=600000
